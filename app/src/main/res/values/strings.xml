    ══════════════════════════════════════════════════════════════ -->

    <!--
        default_web_client_id: ID de cliente OAuth de tipo WEB del proyecto Firebase.
        Necesario para obtener el ID token de Google vía Credential Manager.

        CÓMO OBTENERLO:
          1. Firebase Console → Authentication → Sign-in method → habilitar "Google".
             Esto crea automáticamente un OAuth client de tipo Web (client_type 3).
          2. Descargar el google-services.json actualizado (tendrá el oauth_client),
             o copiar el "Web client ID" desde Google Cloud Console → APIs y servicios
             → Credenciales → "Web client (auto created by Google Service)".
          3. Pegar ese valor aquí (formato: NNNN-xxxx.apps.googleusercontent.com).

        Mientras esté como placeholder, el login con Google mostrará un error claro;
        el login con email/contraseña funciona sin este valor.
    -->
    <string name="default_web_client_id" translatable="false">TODO_REEMPLAZAR_WEB_CLIENT_ID.apps.googleusercontent.com</string>

