<?xml version="1.0" encoding="utf-8"?>
<!--
    poster_error.xml — se muestra cuando una URL de poster FALLA al cargar.
    Se distingue visualmente del placeholder (que es un gris liso "cargando")
    con un borde punteado gris, para saber a simple vista si una URL concreta
    falló vs. si simplemente no hay red / no se disparó la carga.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurfaceVariant" />
            <stroke
                android:width="1dp"
                android:color="@color/colorDivider"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</layer-list>
