    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!--
        Brújula — EXPLORE
        Círculo base + flecha norte (rellena) + flecha sur (hueca)
    -->
    <!-- Círculo exterior -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/white"
        android:strokeWidth="1.8"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z" />
    <!-- Aguja norte (punta arriba-derecha, rellena) -->
    <path
        android:fillColor="@color/white"
        android:pathData="M12,12 L15,7 L12.7,11.3 Z" />
    <!-- Aguja sur (punta abajo-izquierda, stroke) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/white"
        android:strokeWidth="1.4"
        android:pathData="M12,12 L9,17 L11.3,12.7 Z" />
    <!-- Punto central pequeño -->
    <path
        android:fillColor="@color/white"
        android:pathData="M12,11 A1,1 0 1,0 12,13 A1,1 0 1,0 12,11 Z" />
</vector>
