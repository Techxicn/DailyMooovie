<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay transparente con esquinas redondeadas para el poster.
    Se usa como foreground del FrameLayout para simular clipToOutline.
    El trick: outer_radius recorta visualmente los ángulos del ImageView.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="14dp" />
</shape>
