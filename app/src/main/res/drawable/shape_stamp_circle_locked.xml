<?xml version="1.0" encoding="utf-8"?>
<!--
    Sello bloqueado/pendiente.
    Android no soporta dashEffect en <stroke> de <shape>.
    Solución: usamos un layer-list con una línea de stroke sólido
    en color muy tenue (simulando "punteado" visualmente) +
    el efecto de línea discontinua se logra via LayerDrawable
    en código si se requiere precisión. Para el diseño XML estático
    usamos stroke de color @color/colorOnSurfaceFaint que sobre fondo
    oscuro parece un borde sutil / "vacío".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/colorOnSurfaceFaint"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
</shape>
