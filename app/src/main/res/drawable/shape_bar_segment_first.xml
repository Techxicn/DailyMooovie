<?xml version="1.0" encoding="utf-8"?>
<!-- Primer segmento del stacked bar (Drama, rojo #E63946).
     Corner solo en extremo izquierdo. El clipToOutline del contenedor
     maneja el recorte global, pero este shape da la referencia visual
     correcta en el editor sin clipToOutline activo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFE63946" />
    <corners
        android:topLeftRadius="8dp"
        android:bottomLeftRadius="8dp"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
