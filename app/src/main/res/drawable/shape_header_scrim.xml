<?xml version="1.0" encoding="utf-8"?>
<!--
    Scrim del header de mapa.
    Capa semitransparente que oscurece la imagen de fondo para garantizar
    legibilidad del texto superpuesto (nombre de país / ciudad).
    Degradado de abajo hacia arriba: opaco abajo (texto encima), transparente arriba.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#00000000"
        android:centerColor="#66000000"
        android:endColor="#CC000000"
        android:angle="270" />
</shape>
