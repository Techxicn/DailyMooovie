<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del avatar de perfil.
    Cuadrado con corners redondeados 14dp.
    Color: rojo oscuro (#8A1A1A) — se puede sobreescribir via backgroundTint.
-->
