<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_year_in_film.xml
    ══════════════════════════
    Pantalla "AÑO EN PELÍCULAS" — pantalla secundaria desde Journey.
    Tab activo: navJourney.

    Paleta de géneros (6 colores en escala rojo/naranja/gris):
      Drama          #FFE63946   rojo pleno      44 → 27.0%
      Acción         #FFFF6B35   naranja         32 → 19.6%
      Comedia        #FFFF9B6B   naranja claro   27 → 16.6%
      Ciencia ficción#FF8A3A3A   rojo oscuro     24 → 14.7%
      Suspenso       #FF4D4D4D   gris oscuro     19 → 11.7%
      Terror         #FF2E2E2E   gris muy oscuro 14 → 8.6%
      (otros fondo)  colorSurfaceVariant

    Total: 160 películas con género asignado (el resto sin género).
    Proporción visual del stacked bar = peso * match_parent via layout_weight.

    Secciones:
      1. Header: back + share
      2. Hero: label rojo / año enorme / descripción
      3. Stats 2 columnas
      4. Stacked bar + lista de géneros
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  1. HEADER — back + share                             ║
             ╚══════════════════════════════════════════════════════╝ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Botón atrás -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back_button"
                android:clickable="true"
                android:focusable="true" />

            <!-- Botón compartir -->
            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_share"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_share_button"
                android:clickable="true"
                android:focusable="true" />

        </RelativeLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  2. HERO: label / año enorme / descripción            ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Label rojo pequeño -->
            <TextView
                android:id="@+id/tvYearInFilmLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TU AÑO EN PELÍCULAS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- Año enorme -->
            <TextView
                android:id="@+id/tvYearHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026"
                android:textSize="96sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.82"
                android:includeFontPadding="false"
                tools:ignore="HardcodedText" />

            <!-- Línea descriptiva -->
            <TextView
                android:id="@+id/tvYearDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="183 películas. 6 géneros. 18 países.\nUna película al día."
                android:textSize="15sp"
                android:textColor="@color/colorOnSurfaceMuted"
                android:lineSpacingMultiplier="1.4"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Separador fino -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  3. ESTADÍSTICAS — 2 columnas                         ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Columna izquierda: Descubiertas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvStatDiscoveredYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="243"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="0.88"
                    android:includeFontPadding="false"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="DESCUBIERTAS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Divisor vertical -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/colorDivider"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <!-- Columna derecha: Vistas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    android:id="@+id/tvStatWatchedYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="183"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccentRed"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="0.88"
                    android:includeFontPadding="false"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="VISTAS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  4. SECCIÓN GÉNEROS                                   ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp">

            <!-- Label de sección -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="14dp"
                android:text="GÉNEROS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceMuted"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- ── STACKED BAR ──────────────────────────────────────
                 Barra horizontal segmentada, height 16dp, sin corners globales.
                 Solo el primer y último segmento llevan corner en sus extremos
                 para redondear el conjunto. Los segmentos internos usan
                 shape_genre_bar_segment (sin corners).

                 Pesos proporcionales a los valores (total = 163):
                   Drama          44 → weight="44"
                   Acción         32 → weight="32"
                   Comedia        27 → weight="27"
                   Ciencia ficción 24 → weight="24"
                   Suspenso       19 → weight="19"
                   Terror         14 → weight="14"
                   (gap visual)    3 → weight="3"  colorSurfaceVariant
            ─────────────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/genreStackedBar"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:weightSum="163"
                android:clipToOutline="true"
                android:background="@drawable/shape_stacked_bar_container">

                <!-- Drama → rojo pleno #E63946 — primer segmento, corner izquierdo -->
                <View
                    android:id="@+id/barSegmentDrama"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="44"
                    android:background="@drawable/shape_bar_segment_first"
                    tools:ignore="HardcodedText" />

                <!-- Gap 1dp entre segmentos (vista transparente de 1dp) -->
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/colorBackground" />

                <!-- Acción → naranja #FF6B35 -->
                <View
                    android:id="@+id/barSegmentAction"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="32"
                    android:background="#FFFF6B35" />

                <!-- Gap -->
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/colorBackground" />

                <!-- Comedia → naranja claro #FF9B6B -->
                <View
                    android:id="@+id/barSegmentComedy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="27"
                    android:background="#FFFF9B6B" />

                <!-- Gap -->
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/colorBackground" />

                <!-- Ciencia ficción → rojo oscuro #8A3A3A -->
                <View
                    android:id="@+id/barSegmentSciFi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="24"
                    android:background="#FF8A3A3A" />

                <!-- Gap -->
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/colorBackground" />

                <!-- Suspenso → gris oscuro #4D4D4D -->
                <View
                    android:id="@+id/barSegmentThriller"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="19"
                    android:background="#FF4D4D4D" />

                <!-- Gap -->
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="@color/colorBackground" />

                <!-- Terror → gris muy oscuro #2E2E2E, último segmento con corner derecho -->
                <View
                    android:id="@+id/barSegmentHorror"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="14"
                    android:background="@drawable/shape_bar_segment_last" />

                <!-- Resto sin género (no visto) → surface variant -->
                <View
                    android:id="@+id/barSegmentOther"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:background="@color/colorSurfaceVariant" />

            </LinearLayout>

            <!-- ── LISTA DE GÉNEROS ────────────────────────────────
                 Cada fila: cuadro color 10×10dp + nombre + valor derecha
                 Separadas por View de 1dp colorDivider.
            ─────────────────────────────────────────────────────── -->

            <!-- Drama -->
            <LinearLayout
                android:id="@+id/rowGenreDrama"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FFE63946"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Drama"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCountDrama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="44"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:minWidth="36dp"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View style="@style/Widget.DM.Divider" />

            <!-- Acción -->
            <LinearLayout
                android:id="@+id/rowGenreAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FFFF6B35"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acción"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCountAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:minWidth="36dp"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View style="@style/Widget.DM.Divider" />

            <!-- Comedia -->
            <LinearLayout
                android:id="@+id/rowGenreComedy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FFFF9B6B"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Comedia"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCountComedy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:minWidth="36dp"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View style="@style/Widget.DM.Divider" />

            <!-- Ciencia ficción -->
            <LinearLayout
                android:id="@+id/rowGenreSciFi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FF8A3A3A"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ciencia ficción"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCountSciFi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:minWidth="36dp"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View style="@style/Widget.DM.Divider" />

            <!-- Suspenso -->
            <LinearLayout
                android:id="@+id/rowGenreThriller"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FF4D4D4D"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Suspenso"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCountThriller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:minWidth="36dp"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View style="@style/Widget.DM.Divider" />

            <!-- Terror -->
            <LinearLayout
                android:id="@+id/rowGenreHorror"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@color/colorSurfaceElevated"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Terror"
                    android:textSize="14sp"
                    android:textColor="@color/colorOnBackground"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCountHorror"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:minWidth="36dp"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
