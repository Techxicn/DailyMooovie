<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_settings.xml — MOOOVIE · Pantalla SETTINGS (Ajustes)
    ═════════════════════════════════════════════════════════════
    Diseño blanco/amarillo/plano coherente con el resto de la app.

    Estructura:
      NestedScrollView
        └── LinearLayout vertical
              ├── [HEADER] flecha atrás + título "Ajustes"
              ├── [SECTION] label amarillo "Notificaciones" + línea
              └── [FILA] Recordatorio diario: título + descripción + Switch amarillo
                    └── nota de permiso (visible solo si el permiso está bloqueado)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── HEADER: flecha atrás + título ────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.DM.ScreenTitle" />

        </LinearLayout>

        <!-- ── SECTION LABEL: "Notificaciones" + línea amarilla ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_notifications_section"
                android:textAppearance="@style/TextAppearance.DM.SectionLabel" />

            <View
                style="@style/Widget.DM.SectionLine" />

        </LinearLayout>

        <!-- ── FILA: Recordatorio diario (título/desc + switch) ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_daily_reminder_title"
                    android:textAppearance="@style/TextAppearance.DM.TitleCard" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_daily_reminder_desc"
                    android:textAppearance="@style/TextAppearance.DM.Body" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDailyReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_daily_reminder_title" />

        </LinearLayout>

        <!-- ── NOTA de permiso bloqueado (oculta por defecto) ───── -->
        <TextView
            android:id="@+id/tvPermissionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:text="@string/settings_permission_blocked"
            android:textAppearance="@style/TextAppearance.DM.Body"
            android:textColor="@color/colorOnSurfaceMuted"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ── DIVIDER ──────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ── SECTION LABEL: "Apariencia" + línea amarilla ─────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance_section"
                android:textAppearance="@style/TextAppearance.DM.SectionLabel" />

            <View
                style="@style/Widget.DM.SectionLine" />

        </LinearLayout>

        <!-- ── FILA: Modo oscuro (título/desc + switch) ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_dark_mode_title"
                    android:textAppearance="@style/TextAppearance.DM.TitleCard" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_dark_mode_desc"
                    android:textAppearance="@style/TextAppearance.DM.Body" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_dark_mode_title" />

        </LinearLayout>

        <!-- ── DIVIDER ──────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
