<?xml version="1.0" encoding="utf-8"?>
<!--
    item_passport_stamp.xml
    ───────────────────────
    Ítem del grid de sellos en Movie Passport.
    Se infla en un RecyclerView con GridLayoutManager(spanCount=3).

    Layout vertical centrado:
      ┌──────────────────────────────┐
      │   [código ISO — ej "USA"]    │   tvStampCode  12sp bold rojo/muted
      │  ╭────────────────────────╮  │
      │  │   círculo 80×80dp      │  │   ivStampCircle (background intercambiable)
      │  │   (active/locked)      │  │
      │  ╰────────────────────────╯  │
      │   [ciudad — ej "New York"]   │   tvStampCity  10sp muted
      └──────────────────────────────┘

    En el Adapter:
      if (stamp.unlocked) {
          ivStampCircle.background = shape_stamp_circle_active
          tvStampCode.setTextColor(colorAccentRed)
          tvStampCity.visibility = View.VISIBLE
      } else {
          ivStampCircle.background = shape_stamp_circle_locked
          tvStampCode.setTextColor(colorOnSurfaceFaint)
          tvStampCity.visibility = View.INVISIBLE
      }

    IDs: tvStampCode, ivStampCircle, tvStampCity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Código ISO del país: "USA", "GBR", etc. -->
    <TextView
        android:id="@+id/tvStampCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="USA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorAccentRed"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        tools:ignore="HardcodedText" />

    <!-- Círculo del sello -->
    <FrameLayout
        android:id="@+id/ivStampCircle"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/shape_stamp_circle_active">

        <!--
            Contenido interior del sello activo:
            En un sello desbloqueado se puede mostrar una imagen de poster
            con clipToOutline, o simplemente dejar el fondo semitransparente.
            Para sellos bloqueados el interior queda vacío.

            ImageView interior (solo visible si unlocked y hay imagen):
        -->
        <ImageView
            android:id="@+id/ivStampInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:visibility="gone" />

    </FrameLayout>

    <!-- Ciudad / referencia: "New York", "London", etc. -->
    <TextView
        android:id="@+id/tvStampCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="New York"
        android:textSize="10sp"
        android:textColor="@color/colorOnSurfaceMuted"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:ellipsize="end"
        tools:ignore="HardcodedText" />

</LinearLayout>
