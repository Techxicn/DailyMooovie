<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_today.xml — MOOOVIE · Pantalla TODAY / Daily Film (home)
    ════════════════════════════════════════════════════════════════
    Diseño: fondo blanco, texto negro, acento amarillo, plano (sin sombras).
    Tab activo en bottom nav: ícono de play (Today).

    Estructura:
      NestedScrollView
        └── LinearLayout vertical
              ├── [HEADER] fecha (izq) + contador X/Y (der)
              ├── [SECTION] label amarillo "Mooovie of the day!" + línea que se extiende
              └── <include view_movie_content>  (poster + título + subtítulo + sinopsis + botones)

    El contenido de película se comparte con la pantalla FILM vía view_movie_content.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

<androidx.core.widget.NestedScrollView
    android:id="@+id/contentScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ── HEADER: fecha (izq) + contador X/Y (der) ─────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today_date"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                android:letterSpacing="0.06"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvPositionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/today_counter"
                android:textAppearance="@style/TextAppearance.DM.Counter" />

        </LinearLayout>

        <!-- ── SECTION LABEL: "Mooovie of the day!" + línea amarilla ── -->
        <LinearLayout
            android:id="@+id/sectionHeaderToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_section_label"
                android:textAppearance="@style/TextAppearance.DM.SectionLabel" />

            <View
                android:id="@+id/vSectionLine"
                style="@style/Widget.DM.SectionLine" />

        </LinearLayout>

        <!-- ── CONTENIDO DE PELÍCULA (compartido con FILM) ──────── -->
        <include
            android:id="@+id/movieContent"
            layout="@layout/view_movie_content" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

    <!-- ── LOADER centrado ──────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:contentDescription="@string/cd_loading" />

    <!-- ── ESTADO DE ERROR centrado ─────────────────────────────── -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center"
        android:text="@string/state_error_generic"
        android:textColor="@color/colorOnSurfaceMuted"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
