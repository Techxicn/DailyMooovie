<?xml version="1.0" encoding="utf-8"?>
<!--
    item_country_stamp.xml
    ──────────────────────
    Sello de país para el scroll horizontal "SELLOS RECIENTES".
    Ancho fijo 72dp.

    Layout vertical:
      [miniatura cuadrada 72×72dp, corners 8dp]
      [código ISO en rojo, 11sp bold, centrado]

    IDs: ivStampPoster, tvStampCode.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_marginEnd="10dp">

    <!-- Miniatura cuadrada -->
    <ImageView
        android:id="@+id/ivStampPoster"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:background="@drawable/shape_poster_square"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_movie_poster"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Código de país en rojo -->
    <TextView
        android:id="@+id/tvStampCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="USA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/colorAccentRed"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        tools:ignore="HardcodedText" />

</LinearLayout>
