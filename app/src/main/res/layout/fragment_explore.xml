<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_explore.xml — MOOOVIE · Pantalla FILM CATALOG
    ═══════════════════════════════════════════════════════
    Tab CATALOG (ícono grid). Diseño blanco/amarillo/plano.

    Estructura:
      LinearLayout vertical
        ├── [SECTION] label amarillo "Mooovies of the years!" + línea + contador "05/30"
        ├── [MES] selector: "<"  SEPTEMBER 2026  ">"
        └── [GRID] RecyclerView GridLayoutManager(3 columnas) → item_catalog_movie

    El grid se llena dinámicamente con las películas recomendadas del mes y su
    estado real (vista / no vista) desde la lógica del proyecto. Las flechas de
    mes están listas para disparar el cambio de mes (btnPrevMonth / btnNextMonth).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

<LinearLayout
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ── SECTION LABEL + LÍNEA + CONTADOR (misma fila) ────────── -->
    <LinearLayout
        android:id="@+id/sectionHeaderCatalog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_section_label"
            android:textAppearance="@style/TextAppearance.DM.SectionLabel" />

        <!-- Línea amarilla que se extiende (weight=1 ocupa el espacio libre) -->
        <View
            android:id="@+id/vSectionLine"
            style="@style/Widget.DM.SectionLine"
            android:layout_weight="1" />

        <!-- Contador X/Y a la derecha -->
        <TextView
            android:id="@+id/tvPositionCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/catalog_counter"
            android:textAppearance="@style/TextAppearance.DM.Counter" />

    </LinearLayout>

    <!-- ── SELECTOR DE MES:  <   SEPTEMBER 2026   > ─────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- Flecha "<" mes anterior -->
        <ImageView
            android:id="@+id/btnPrevMonth"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left_black"
            app:tint="@color/colorOnBackground"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_prev_month" />

        <!-- Nombre del mes centrado -->
        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/catalog_month"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnBackground"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <!-- Flecha ">" mes siguiente -->
        <ImageView
            android:id="@+id/btnNextMonth"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_right_black"
            app:tint="@color/colorOnBackground"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_next_month" />

    </LinearLayout>

    <!-- ── GRID DE PELÍCULAS (3 columnas, dinámico) ─────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCatalog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_catalog_movie"
        tools:itemCount="9" />

</LinearLayout>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:contentDescription="@string/cd_loading" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center"
        android:text="@string/state_error_generic"
        android:textColor="@color/colorOnSurfaceMuted"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
