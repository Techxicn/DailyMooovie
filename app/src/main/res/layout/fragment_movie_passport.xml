<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_movie_passport.xml
    ════════════════════════════
    Pantalla MOVIE PASSPORT — vista de sellos de países.
    Tab activo: navProfile.

    Secciones:
      1. Header: back + "MOVIE PASSPORT" centrado
      2. Hero: chip "PASAPORTE DIARIO" / título / descripción
      3. RecyclerView grid 3 columnas de sellos (item_passport_stamp)
         Preview estática con 9 includes (tools:visibility)
      4. Contador "5 de 18 países sellados" centrado
      5. Separador + Label "SELLADO POR" (inicio de lista que continúa)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  1. HEADER                                            ║
             ╚══════════════════════════════════════════════════════╝ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back_button"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="MOVIE PASSPORT"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

        </RelativeLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  2. HERO: chip / título / descripción                 ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- Chip "PASAPORTE DIARIO" -->
            <TextView
                android:id="@+id/tvPassportChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_passport_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="PASAPORTE DIARIO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvPassportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cada país que has visto"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="-0.01"
                tools:ignore="HardcodedText" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/tvPassportDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Un sello por país. Se gana al terminar una película, no al abrirla."
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceMuted"
                android:lineSpacingMultiplier="1.4"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  3. GRID DE SELLOS — RecyclerView                     ║
             ║                                                        ║
             ║  En runtime:                                           ║
             ║    rvStamps.layoutManager =                           ║
             ║        GridLayoutManager(context, 3)                  ║
             ║    rvStamps.adapter = PassportStampAdapter(stamps)    ║
             ║    rvStamps.isNestedScrollingEnabled = false          ║
             ║                                                        ║
             ║  tools:listitem muestra la preview en el editor.      ║
             ║                                                        ║
             ║  Nota: GridLayoutManager no se refleja en tools:,     ║
             ║  por eso se añade una previewStampGrid LinearLayout   ║
             ║  con 3 columnas simuladas visible solo en el editor.  ║
             ╚══════════════════════════════════════════════════════╝ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStamps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:listitem="@layout/item_passport_stamp"
            tools:itemCount="9"
            tools:spanCount="3"
            tools:layoutManager="GridLayoutManager"
            tools:ignore="MissingConstraints" />

        <!--
            ── PREVIEW GRID ESTÁTICA (solo editor) ─────────────────
            Simula el grid 3×3 con includes.
            android:visibility="gone" → oculto en runtime.
            tools:visibility="visible" → visible en el editor de diseño.
        -->
        <LinearLayout
            android:id="@+id/previewStampGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Fila 1: USA · GBR · BRA (activos) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Fila 2: JPN · FRA · NGA (activos) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Fila 3: IND · ??? · ??? (bloqueados — círculo punteado) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <include
                    layout="@layout/item_passport_stamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Sello bloqueado — background sobreescrito visualmente -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="•••"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurfaceFaint"
                        android:letterSpacing="0.1"
                        tools:ignore="HardcodedText" />

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/shape_stamp_circle_locked" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text=" "
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Sello bloqueado 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="•••"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurfaceFaint"
                        android:letterSpacing="0.1"
                        tools:ignore="HardcodedText" />

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/shape_stamp_circle_locked" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text=" "
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  4. CONTADOR CENTRADO "5 de 18 países sellados"       ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Número sellados en rojo -->
            <TextView
                android:id="@+id/tvStampedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:fontFamily="sans-serif-condensed"
                tools:ignore="HardcodedText" />

            <!-- " de " en muted -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" de "
                android:textSize="14sp"
                android:textColor="@color/colorOnSurfaceMuted"
                tools:ignore="HardcodedText" />

            <!-- Total en blanco -->
            <TextView
                android:id="@+id/tvTotalCountries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                android:fontFamily="sans-serif-condensed"
                tools:ignore="HardcodedText" />

            <!-- Sufijo " países sellados" en muted -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" países sellados"
                android:textSize="14sp"
                android:textColor="@color/colorOnSurfaceMuted"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  5. SEPARADOR + LABEL "SELLADO POR"                   ║
             ║  (inicio de lista que continúa en pantalla siguiente) ║
             ╚══════════════════════════════════════════════════════╝ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Label de sección -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SELLADO POR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceMuted"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- Número de sellos desbloqueados en chip rojo pequeño -->
            <TextView
                android:id="@+id/tvStampedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_chip_active"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="5 países"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:letterSpacing="0.06"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!--
            Primer ítem de la lista "Sellado por" (país + película que lo desbloqueó).
            La lista completa se genera dinámicamente en el Fragment; aquí se muestra
            solo el primero como referencia visual de la sección.
        -->
        <LinearLayout
            android:id="@+id/rowSealedByFirst"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Código del país en rojo -->
            <TextView
                android:id="@+id/tvSealCode"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="USA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:letterSpacing="0.06"
                tools:ignore="HardcodedText" />

            <!-- Nombre completo del país -->
            <TextView
                android:id="@+id/tvSealCountry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Estados Unidos"
                android:textSize="14sp"
                android:textColor="@color/colorOnBackground"
                tools:ignore="HardcodedText" />

            <!-- Película que desbloqueó el sello -->
            <TextView
                android:id="@+id/tvSealMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Chinatown"
                android:textSize="12sp"
                android:textColor="@color/colorOnSurfaceMuted"
                android:maxLines="1"
                android:ellipsize="end"
                tools:ignore="HardcodedText" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- Indicador de más ítems -->
        <TextView
            android:id="@+id/tvSeeAllSealed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="Ver los 5 sellos →"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccentRed"
            android:background="?attr/selectableItemBackground"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
