<?xml version="1.0" encoding="utf-8"?>
<!--
    item_movie_grid.xml
    ───────────────────
    Ítem del RecyclerView con GridLayoutManager(spanCount=3) en Mis Películas.
    Ancho: match_parent dentro de la celda del grid.

    Layout vertical:
      [poster — relación 2:3, corners 8dp]
      [título — bold condensed, 2 líneas máx]
      [director — gris, 1 línea máx]
      [fila estrellas — 5 ImageView ic_star_filled 12dp]

    IDs: ivGridPoster, tvGridTitle, tvGridDirector, rowGridStars.
    El rating se refleja ocultando estrellas:
      rating=3 → starGrid4 y starGrid5 → alpha=0.25
    En el Adapter se recorre rowGridStars.children y aplica alpha.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <!-- Poster 2:3 con corners 8dp.
         La altura se fija en código o via ConstraintLayout ratio;
         aquí usamos minHeight como proxy visual para el editor. -->
    <ImageView
        android:id="@+id/ivGridPoster"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp"
        android:scaleType="centerCrop"
        android:background="@drawable/shape_poster_small_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_movie_poster"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvGridTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Título de la película"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnBackground"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        tools:ignore="HardcodedText" />

    <!-- Director -->
    <TextView
        android:id="@+id/tvGridDirector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Director"
        android:textSize="10sp"
        android:textColor="@color/colorOnSurfaceMuted"
        android:maxLines="1"
        android:ellipsize="end"
        tools:ignore="HardcodedText" />

    <!-- Fila de 5 estrellas -->
    <LinearLayout
        android:id="@+id/rowGridStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/starGrid1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="1dp"
            android:src="@drawable/ic_star_filled"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/starGrid2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="1dp"
            android:src="@drawable/ic_star_filled"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/starGrid3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="1dp"
            android:src="@drawable/ic_star_filled"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/starGrid4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="1dp"
            android:src="@drawable/ic_star_filled"
            android:alpha="0.25"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/starGrid5"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_filled"
            android:alpha="0.25"
            android:contentDescription="@null" />

    </LinearLayout>

</LinearLayout>
