<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_my_movies.xml — MOOOVIE · Pantalla WATCHLIST
    ══════════════════════════════════════════════════════
    Tab WATCHLIST (ícono capas/stack → navMovies). Diseño blanco/amarillo/plano.

    Estructura:
      LinearLayout vertical
        ├── [FILA] "12 Moovies in your Watchlist" (izq, gris) + contador "01/12" (der)
        ├── [SECTION] label amarillo "Your Watchlist" + línea que se extiende
        └── [GRID] RecyclerView GridLayoutManager(3) → item_catalog_movie (mismo item que Catalog)

    El grid se llena dinámicamente con las películas guardadas en la watchlist del
    usuario provistas por la lógica del proyecto.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

<LinearLayout
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ── FILA SUPERIOR: conteo (izq) + contador X/Y (der) ─────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvWatchlistCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/watchlist_count"
            android:textSize="13sp"
            android:textColor="@color/colorOnSurfaceMuted"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/tvPositionCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/watchlist_counter"
            android:textAppearance="@style/TextAppearance.DM.Counter" />

    </LinearLayout>

    <!-- ── SECTION LABEL: "Your Watchlist" + línea amarilla ─────── -->
    <LinearLayout
        android:id="@+id/sectionHeaderWatchlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_section_label"
            android:textAppearance="@style/TextAppearance.DM.SectionLabel" />

        <View
            android:id="@+id/vSectionLine"
            style="@style/Widget.DM.SectionLine" />

    </LinearLayout>

    <!-- ── GRID DE PELÍCULAS (3 columnas, dinámico) ─────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWatchlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_catalog_movie"
        tools:itemCount="9" />

</LinearLayout>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:contentDescription="@string/cd_loading" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center"
        android:text="@string/state_error_generic"
        android:textColor="@color/colorOnSurfaceMuted"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
