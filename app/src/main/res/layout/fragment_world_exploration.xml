<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_world_exploration.xml
    ════════════════════════════════
    Pantalla WORLD EXPLORATION — vista de lista de países.

    Nota de navegación: esta pantalla cuelga de Journey en el flujo actual.
    Si se decide moverla a Profile, cambia el tab activo de navJourney → navProfile
    en el Fragment/Activity correspondiente (solo lógica, no afecta este layout).

    Secciones:
      1. Header: back + título centrado "WORLD EXPLORATION"
      2. Label sección "MÁS VISTO"
      3. RecyclerView de barras por país (lista de items_country_bar)
         ── 6 items de muestra en la preview con <include>
         ── En runtime se reemplaza por el Adapter del RV
      4. Label sección "SELLOS RECIENTES"
      5. Scroll horizontal de sellos (4 × item_country_stamp)
      6. Label "NUNCA VISTO DESDE"
      7. Texto descriptivo en gris con países pendientes
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  1. HEADER                                            ║
             ╚══════════════════════════════════════════════════════╝ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Botón atrás -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back_button"
                android:clickable="true"
                android:focusable="true" />

            <!-- Título centrado -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="WORLD EXPLORATION"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

        </RelativeLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  2. LABEL "MÁS VISTO"                                 ║
             ╚══════════════════════════════════════════════════════╝ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="MÁS VISTO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurfaceMuted"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            tools:ignore="HardcodedText" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  3. LISTA DE PAÍSES — RecyclerView                    ║
             ║                                                        ║
             ║  En runtime: RecyclerView con CountryBarAdapter.      ║
             ║  En la preview de diseño: 6 <include> hardcodeados.   ║
             ║  El RV se configura con:                              ║
             ║    rvCountries.layoutManager = LinearLayoutManager    ║
             ║    rvCountries.isNestedScrollingEnabled = false       ║
             ║    rvCountries.adapter = CountryBarAdapter(data)      ║
             ╚══════════════════════════════════════════════════════╝ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCountries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_country_bar"
            tools:itemCount="6"
            tools:ignore="MissingConstraints" />

        <!-- ── Preview visual estática (tools:visibility="gone" en runtime)
             Visible solo en el editor de Android Studio para ver la lista.
             En el Fragment se oculta con: previewList.visibility = View.GONE -->
        <LinearLayout
            android:id="@+id/previewCountryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Estados Unidos — 42 (scaleX = 42/42 = 1.0) -->
            <include layout="@layout/item_country_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Reino Unido — 37 (scaleX ≈ 0.88) -->
            <include layout="@layout/item_country_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Brasil — 18 (scaleX ≈ 0.43) -->
            <include layout="@layout/item_country_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Japón — 15 (scaleX ≈ 0.36) -->
            <include layout="@layout/item_country_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Francia — 12 (scaleX ≈ 0.29) -->
            <include layout="@layout/item_country_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Nigeria — 9 (scaleX ≈ 0.21) -->
            <include layout="@layout/item_country_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  4. LABEL "SELLOS RECIENTES"                          ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SELLOS RECIENTES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceMuted"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvSeeAllStamps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VER TODOS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="8dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  5. SCROLL HORIZONTAL DE SELLOS                       ║
             ╚══════════════════════════════════════════════════════╝ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Sello USA -->
                <include
                    android:id="@+id/stampUsa"
                    layout="@layout/item_country_stamp"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content" />

                <!-- Sello GBR -->
                <include
                    android:id="@+id/stampGbr"
                    layout="@layout/item_country_stamp"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content" />

                <!-- Sello BRA -->
                <include
                    android:id="@+id/stampBra"
                    layout="@layout/item_country_stamp"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content" />

                <!-- Sello JPN -->
                <include
                    android:id="@+id/stampJpn"
                    layout="@layout/item_country_stamp"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  6. LABEL "NUNCA VISTO DESDE"                         ║
             ╚══════════════════════════════════════════════════════╝ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="8dp"
            android:text="NUNCA VISTO DESDE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurfaceMuted"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            tools:ignore="HardcodedText" />

        <!-- Separador fino -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  7. TEXTO PAÍSES NUNCA VISTOS                         ║
             ╚══════════════════════════════════════════════════════╝ -->
        <TextView
            android:id="@+id/tvNeverSeen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:text="Egipto · Vietnam · Turquía · Perú · Corea del Sur — y 154 más."
            android:textSize="14sp"
            android:textColor="@color/colorOnSurfaceMuted"
            android:lineSpacingMultiplier="1.5"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
