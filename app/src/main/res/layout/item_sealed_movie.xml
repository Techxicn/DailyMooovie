<?xml version="1.0" encoding="utf-8"?>
<!--
    item_sealed_movie.xml
    ─────────────────────
    Ítem del RecyclerView "SELLADO POR" en fragment_passport_detail.
    Fila horizontal:
      [poster 52×72dp] [columna título/director/año] [código país rojo]

    IDs: ivSealedPoster, tvSealedTitle, tvSealedMeta, tvSealedCountryCode.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Poster pequeño rectangular 52×72dp -->
    <ImageView
        android:id="@+id/ivSealedPoster"
        android:layout_width="52dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:background="@drawable/shape_poster_small_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_movie_poster"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Columna: título + meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSealedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rashomon"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnBackground"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="2"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvSealedMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Akira Kurosawa · 1950"
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceMuted"
            android:maxLines="1"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Código de país en rojo a la derecha -->
    <TextView
        android:id="@+id/tvSealedCountryCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JPN"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorAccentRed"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        tools:ignore="HardcodedText" />

</LinearLayout>
