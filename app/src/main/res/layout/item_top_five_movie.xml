<?xml version="1.0" encoding="utf-8"?>
<!--
    item_top_five_movie.xml
    ───────────────────────
    Fila de la lista Top Five.
    Layout horizontal:
      [número grande rojo 48sp] [poster cuadrado 56×56dp] [columna título/subtítulo]

    Uso: <include> en fragment_top_five.xml con binding de IDs
         tvRank, ivPosterTop, tvMovieTitleTop, tvMovieMetaTop.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Número de ranking -->
    <TextView
        android:id="@+id/tvRank"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/colorAccentRed"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:gravity="center"
        tools:ignore="HardcodedText" />

    <!-- Poster cuadrado -->
    <ImageView
        android:id="@+id/ivPosterTop"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="14dp"
        android:scaleType="centerCrop"
        android:background="@drawable/shape_poster_square"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_movie_poster"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Columna: título + subtítulo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMovieTitleTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la película"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnBackground"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="2"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvMovieMetaTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Director · Año"
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceMuted"
            android:maxLines="1"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>
