<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_profile.xml
    ═════════════════════
    Pantalla PROFILE — tab del bottom navigation.
    Tab activo: navProfile.
    NOTA: sección de Badges/Logros OMITIDA intencionalmente.

    Secciones:
      1. Header: avatar + nombre + subtítulo + ícono ajustes
      2. Tipo de espectador: label rojo + descripción
      3. Fila de 3 estadísticas
      4. TUS GÉNEROS: chips horizontales (scroll)
      5. CALIFICACIÓN PROMEDIO: label + 5 estrellas derecha
      6. RACHA ACTUAL: label + valor derecha
      7. FAVORITAS: scroll horizontal de posters
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  1. HEADER: avatar + nombre + ajustes                 ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <!-- Avatar cuadrado con inicial -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/shape_avatar">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="E"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-condensed"
                    tools:ignore="HardcodedText" />

            </FrameLayout>

            <!-- Columna: nombre + subtítulo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ELENA"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.02"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvProfileSince"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Viendo desde 2026"
                    android:textSize="12sp"
                    android:textColor="@color/colorOnSurfaceMuted"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Ícono ajustes -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_settings"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  2. TIPO DE ESPECTADOR                                 ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Label rojo -->
            <TextView
                android:id="@+id/tvViewerType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EL EXPLORADOR CURIOSO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccentRed"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/tvViewerDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Te mueves entre géneros constantemente y rara vez te quedas en una década por mucho tiempo."
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceMuted"
                android:lineSpacingMultiplier="1.45"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  3. FILA DE 3 ESTADÍSTICAS                            ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <!-- Descubiertas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvStatDiscoveredProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="243"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif-condensed"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCUBIERTAS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:background="@color/colorDivider" />

            <!-- Vistas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvStatWatchedProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="183"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccentRed"
                    android:fontFamily="sans-serif-condensed"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISTAS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:background="@color/colorDivider" />

            <!-- Guardadas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvStatSavedProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="64"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif-condensed"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUARDADAS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  4. TUS GÉNEROS — chips horizontales                 ║
             ║                                                        ║
             ║  RecyclerView horizontal en runtime; aquí preview     ║
             ║  con chips hardcodeados dentro de HorizontalScrollView.║
             ╚══════════════════════════════════════════════════════╝ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp"
            android:text="TUS GÉNEROS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurfaceMuted"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            tools:ignore="HardcodedText" />

        <HorizontalScrollView
            android:id="@+id/scrollGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/genreChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- DRAMA (activo/relleno) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shape_genre_chip_active"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="DRAMA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

                <!-- ACCIÓN (inactivo) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shape_tab_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="ACCIÓN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

                <!-- CIENCIA FICCIÓN (inactivo) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/shape_tab_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="CIENCIA FICCIÓN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  5. CALIFICACIÓN PROMEDIO                             ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CALIFICACIÓN PROMEDIO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceMuted"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- 5 estrellas (4 llenas, 1 tenue) -->
            <LinearLayout
                android:id="@+id/rowAvgStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="2dp" android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="2dp" android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="2dp" android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="2dp" android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="2dp" android:src="@drawable/ic_star_filled"
                    android:alpha="0.25"
                    android:contentDescription="@null" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  6. RACHA ACTUAL                                      ║
             ╚══════════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RACHA ACTUAL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceMuted"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                tools:ignore="HardcodedText" />

            <!-- Fuego + valor -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_fire"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvCurrentStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23 días"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnBackground"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  7. FAVORITAS — scroll horizontal de posters         ║
             ╚══════════════════════════════════════════════════════╝ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp"
            android:text="FAVORITAS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccentRed"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            tools:ignore="HardcodedText" />

        <!-- RecyclerView horizontal en runtime;
             preview con includes en el editor -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_fav_movie"
            tools:itemCount="5"
            tools:orientation="horizontal"
            tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:ignore="MissingConstraints" />

        <!-- Preview estática (gone en runtime) -->
        <HorizontalScrollView
            android:id="@+id/previewFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/item_fav_movie"
                    android:layout_width="96dp" android:layout_height="wrap_content" />
                <include layout="@layout/item_fav_movie"
                    android:layout_width="96dp" android:layout_height="wrap_content" />
                <include layout="@layout/item_fav_movie"
                    android:layout_width="96dp" android:layout_height="wrap_content" />
                <include layout="@layout/item_fav_movie"
                    android:layout_width="96dp" android:layout_height="wrap_content" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ╔══════════════════════════════════════════════════════╗
             ║  8. ACCESOS — Movie Passport / World Exploration     ║
             ║  Filas de menú hacia las colecciones geográficas.     ║
             ╚══════════════════════════════════════════════════════╝ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:background="@color/colorDivider" />

        <!-- Movie Passport -->
        <LinearLayout
            android:id="@+id/rowMoviePassport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Movie Passport"
                android:textSize="14sp"
                android:textColor="@color/colorOnBackground"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="5 sellos"
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceMuted"
                tools:ignore="HardcodedText" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

        <View style="@style/Widget.DM.Divider"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />

        <!-- World Exploration -->
        <LinearLayout
            android:id="@+id/rowWorldExploration"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="World Exploration"
                android:textSize="14sp"
                android:textColor="@color/colorOnBackground"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="18 países"
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceMuted"
                tools:ignore="HardcodedText" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
