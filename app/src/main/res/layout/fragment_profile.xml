<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_profile.xml — MOOOVIE · Pantalla PROFILE
    ══════════════════════════════════════════════════
    Tab PROFILE (ícono persona → navProfile). Diseño blanco/amarillo/plano.

    Estructura:
      NestedScrollView
        └── LinearLayout vertical
              ├── [SECTION] label amarillo "Your Profile" + línea
              ├── [HEADER] avatar amarillo (inicial) + nombre/rol/conteo + 3 íconos (medalla/compartir/ajustes)
              ├── [DIVIDER]
              ├── [STATS] 3 columnas: número grande + label pequeño
              ├── [DIVIDER]
              ├── [SECTION] "Juan Antonio's Mooovie Discoveries"
              └── [DISCOVERIES] RecyclerView horizontal (poster + título) → item_fav_movie

    Los descubrimientos se llenan dinámicamente desde la lógica del proyecto.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── SECTION LABEL: "Your Profile" + línea amarilla ───── -->
        <LinearLayout
            android:id="@+id/sectionHeaderProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_section_label"
                android:textAppearance="@style/TextAppearance.DM.SectionLabel" />

            <View
                android:id="@+id/vSectionLine"
                style="@style/Widget.DM.SectionLine" />

        </LinearLayout>

        <!-- ── HEADER: avatar + nombre/rol/conteo + 3 íconos ────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Avatar cuadrado amarillo con inicial -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/shape_avatar">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/profile_avatar_initial"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnAccent"
                    android:fontFamily="sans-serif" />

            </FrameLayout>

            <!-- Columna: nombre + rol + conteo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_role"
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurfaceMuted" />

                <TextView
                    android:id="@+id/tvProfileWatchedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/profile_watched_count"
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurfaceMuted" />

            </LinearLayout>

            <!-- 3 íconos de acción: medalla / compartir / ajustes -->
            <ImageView
                android:id="@+id/btnAchievements"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_medal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_achievements" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_share_button" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_settings" />

        </LinearLayout>

        <!-- ── DIVIDER ──────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ── STATS: 3 columnas centradas ──────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Watched this year -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvStatYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_stat_year_value"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_stat_year_label"
                    android:textSize="11sp"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Current Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvStatCurrentStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_stat_current_value"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_stat_current_label"
                    android:textSize="11sp"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Longest Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvStatLongestStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_stat_longest_value"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_stat_longest_label"
                    android:textSize="11sp"
                    android:textColor="@color/colorOnSurfaceMuted"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── DIVIDER ──────────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/colorDivider" />

        <!-- ── SECTION: "Juan Antonio's Mooovie Discoveries" ────── -->
        <TextView
            android:id="@+id/tvDiscoveriesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp"
            android:text="@string/profile_discoveries_title"
            android:textAppearance="@style/TextAppearance.DM.TitleCard" />

        <!-- ── DISCOVERIES: RecyclerView horizontal (dinámico) ──── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDiscoveries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:reverseLayout="false"
            android:orientation="horizontal"
            tools:listitem="@layout/item_fav_movie"
            tools:itemCount="3" />

        <!-- ── CERRAR SESIÓN (botón outline) ────────────────────── -->
        <TextView
            android:id="@+id/btnSignOut"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/shape_button_outline"
            android:gravity="center"
            android:text="@string/profile_sign_out"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnBackground"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
